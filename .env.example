GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

PLACES_REVIEWS_TO_LLM=false

GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_PRICE_CHECK_MODEL=gemini-3.5-flash-lite

DEFAULT_CITY=barcelona

PLACES_REQUEST_VEGETARIAN_SIGNAL=true

# Abuse protection for /api/recommend (per client IP)
RATE_LIMIT_MAX_REQUESTS=6
RATE_LIMIT_WINDOW_SEC=600
MAX_CONCURRENT_RUNS=4
# Cost ceiling: completed or started searches per 24 h, per server instance
GLOBAL_MAX_SEARCHES_PER_DAY=100
# Set to false when the app is not behind a proxy that sets x-forwarded-for
TRUST_PROXY_HEADERS=true
